---
import type { Cet6Paper } from "../data/cet6";
import { withBase } from "../utils/paths";

interface Props {
  paper: Cet6Paper;
}

const { paper } = Astro.props;
const previewHref = `/papers/${paper.year}/${paper.month}/${paper.setNumber}/`;
const currentBase = import.meta.env.BASE_URL;
---

<article class="paper-card">
  <a class="paper-card__preview-link" href={withBase(previewHref, currentBase)} aria-label={`进入 ${paper.title} 在线预览页`}>
    <div class="paper-card__preview">
      {
        paper.previewImagePath ? (
          <img
            class="paper-card__preview-image"
            src={withBase(paper.previewImagePath, currentBase)}
            alt={`${paper.title} 预览图`}
            loading="lazy"
          />
        ) : (
          <div class="paper-card__sheet" aria-hidden="true"></div>
        )
      }
    </div>
  </a>

  <div class="paper-card__body">
    <div class="paper-card__head">
      <div>
        <h2 class="paper-card__title">{paper.title}</h2>
      </div>
      <span class="paper-card__badge">第{paper.setNumber}套</span>
    </div>

    <p class="paper-card__meta">点击卡片在线预览，或直接下载 PDF。</p>

    <div class="paper-card__actions">
      <a class="paper-card__button paper-card__button--secondary" href={withBase(previewHref, currentBase)}>
        在线预览
      </a>
      <a class="paper-card__button paper-card__button--primary" href={withBase(paper.pdfPath, currentBase)} download>
        下载 PDF
      </a>
    </div>
  </div>
</article>
