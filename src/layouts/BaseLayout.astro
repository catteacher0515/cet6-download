---
import "../styles/global.css";
import { withBase } from "../utils/paths";

type NavItem = {
  href: string;
  label: string;
};

interface Props {
  title: string;
  description: string;
  pathname: string;
  shellClassName?: string;
  mainClassName?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
}

const {
  title,
  description,
  pathname,
  shellClassName = "",
  mainClassName = "",
  hideHeader = false,
  hideFooter = false
} = Astro.props;

const navItems: NavItem[] = [
  { href: "/", label: "首页" },
  { href: "/papers", label: "真题下载" },
  { href: "/about", label: "关于本站" }
];

const brandLabel = "六级真题资料站";
const currentBase = import.meta.env.BASE_URL;
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class={`site-shell ${shellClassName}`.trim()}>
      {
        hideHeader ? null : (
          <header class="site-header">
            <div class="brand">
              <span class="brand-mark"></span>
              <span>{brandLabel}</span>
            </div>

            <nav class="site-nav" aria-label="主导航">
              {navItems.map((item) => (
                <a href={withBase(item.href, currentBase)} aria-current={pathname === item.href ? "page" : undefined}>
                  {item.label}
                </a>
              ))}
            </nav>
          </header>
        )
      }

      <main class={mainClassName}>
        <slot />
      </main>

      {
        hideFooter ? null : (
          <footer class="site-footer">
          </footer>
        )
      }
    </div>
  </body>
</html>
