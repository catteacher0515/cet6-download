---
import { papers } from "../data/cet6";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const latestPaper = papers[0];
const currentBase = import.meta.env.BASE_URL;
---

<BaseLayout
  title="六级真题工具站"
  description="提供六级真题 PDF 直接下载，后续支持听力在线播放。"
  pathname="/"
  hideFooter={true}
>
  <section class="page-section home-hero">
    <div class="home-hero__grid">
      <div class="home-hero__content">
        <p class="home-hero__eyebrow">免费六级真题工具站</p>
        <h1 class="home-hero__title">
          <span>六级真题</span>
        </h1>
        <p class="home-hero__subtitle">直接下载</p>
        <p class="home-hero__lead">不登录，不跳转，不做无关拦截。</p>
        <p class="home-hero__detail">你进来之后要做的事只有一件：更快拿到需要的六级真题 PDF。</p>
        <div class="home-hero__actions">
          <a class="home-hero__button" href={withBase("/papers", currentBase)}>进入真题下载页</a>
        </div>
      </div>

      <aside class="home-hero__panel">
        <p class="home-update__eyebrow">最近更新</p>
        <h2 class="home-update__title">{latestPaper.title}</h2>
        <p class="home-update__copy">最新一套真题已经接入站点，可直接在线预览并下载 PDF。</p>
        <dl class="home-hero__meta">
          <div>
            <dt>年份</dt>
            <dd>{latestPaper.year} 年</dd>
          </div>
          <div>
            <dt>场次</dt>
            <dd>{latestPaper.month === 12 ? "下半年" : "上半年"}</dd>
          </div>
          <div>
            <dt>套数</dt>
            <dd>第 {latestPaper.setNumber} 套</dd>
          </div>
        </dl>
        <a class="home-update__link" href={withBase(`/papers/${latestPaper.year}/${latestPaper.month}/${latestPaper.setNumber}/`, currentBase)}>
          查看最新真题
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
