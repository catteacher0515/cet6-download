---
import PaperCard from "../components/PaperCard.astro";
import { buildBatchDownloadFilename, buildDefaultBatchArchivePath, groupPapersBySession, papers } from "../data/cet6";
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../utils/paths";

const groups = groupPapersBySession(papers);
const currentBase = import.meta.env.BASE_URL;
const batchDownloadPapers = groups.flatMap((group) =>
  group.papers.map((paper) => ({
    id: paper.id,
    title: paper.title,
    pdfPath: withBase(paper.pdfPath, currentBase),
    sessionLabel: `${paper.year}年${paper.month === 12 ? "12月" : "6月"}`,
    batchFilename: buildBatchDownloadFilename(paper.year, paper.month, paper.setNumber)
  }))
);
const defaultBatchArchivePath = withBase(buildDefaultBatchArchivePath(), currentBase);
---

<BaseLayout
  title="真题下载"
  description="按年份查看六级真题，直接下载 PDF。"
  pathname="/papers"
  shellClassName="site-shell--full-bleed"
>
  <section class="papers-hero papers-hero--compact page-section">
    <div class="papers-hero__header">
      <span class="papers-hero__year-tag">2026</span>
      <h1 class="papers-hero__title">大学英语六级真题在线</h1>
      <p class="papers-hero__subline">2025 年 12 月起，逐步整理历年真题试卷</p>
    </div>

    <div class="papers-hero__chips">
      <span>真题 PDF</span>
      <span>按年份整理</span>
      <span>在线预览</span>
      <span>直接下载</span>
    </div>

    <p class="papers-hero__copy">
      点击卡片主体进入试卷预览页，点击按钮直接下载 PDF。
    </p>

    <div class="papers-hero__actions">
      <button class="papers-hero__batch-button" type="button" data-batch-download-open>
        批量下载
      </button>
    </div>
  </section>

  {groups.map((group) => (
    <section class="page-section papers-session papers-session--compact">
      <div class="papers-section__head papers-section__head--center">
        <h2 class="papers-session__title">{group.year}年 - {group.month === 12 ? "下半年" : "上半年"}</h2>
        <p class="page-copy">{group.papers.length} 套真题</p>
      </div>

      <div class="papers-grid papers-grid--three-up">
        {group.papers.map((paper) => (
          <PaperCard paper={paper} />
        ))}
      </div>
    </section>
  ))}

  <section class="page-section">
    <div class="panel">
      <p class="page-copy">
        当前提供在线预览、PDF 下载和听力。答案，解析在后续版本逐步补充
      </p>
    </div>
  </section>

  <dialog class="batch-download-dialog" data-batch-download-dialog aria-labelledby="batch-download-title">
    <form class="batch-download-dialog__surface" method="dialog">
      <div class="batch-download-dialog__header">
        <div>
          <p class="batch-download-dialog__eyebrow">批量下载</p>
          <h2 class="batch-download-dialog__title" id="batch-download-title">批量下载真题</h2>
        </div>
        <button class="batch-download-dialog__close" type="button" data-batch-download-close aria-label="关闭弹窗">
          ×
        </button>
      </div>

      <p class="batch-download-dialog__copy">
        默认全选全部真题。你也可以只勾选自己需要的年份和套题，最后会打包成一个 zip 包下载。
      </p>

      <label class="batch-download-dialog__master">
        <input type="checkbox" checked data-batch-download-select-all />
        <span>全选全部真题</span>
      </label>

      <p class="batch-download-dialog__summary" data-batch-download-summary>
        已选 {batchDownloadPapers.length} 套真题
      </p>

      <div class="batch-download-dialog__groups">
        {groups.map((group) => (
          <section class="batch-download-group">
            <h3 class="batch-download-group__title">{group.year}年 {group.month}月</h3>
            <div class="batch-download-group__list">
              {group.papers.map((paper) => (
                <label class="batch-download-item">
                  <input
                    type="checkbox"
                    checked
                    value={paper.id}
                    data-batch-download-item
                  />
                  <span class="batch-download-item__meta">{buildBatchDownloadFilename(paper.year, paper.month, paper.setNumber)}</span>
                </label>
              ))}
            </div>
          </section>
        ))}
      </div>

      <div class="batch-download-dialog__footer">
        <p class="batch-download-dialog__status" data-batch-download-status aria-live="polite"></p>
        <div class="batch-download-dialog__actions">
          <button class="batch-download-dialog__secondary" type="button" data-batch-download-close>
            取消
          </button>
          <button class="batch-download-dialog__primary" type="button" data-batch-download-start>
            开始下载
          </button>
        </div>
      </div>
    </form>
  </dialog>

  <script id="papers-batch-download-data" type="application/json" set:html={JSON.stringify(batchDownloadPapers)}></script>
  <script id="papers-batch-download-default-archive" type="application/json" set:html={JSON.stringify(defaultBatchArchivePath)}></script>
  <script>
    import "../scripts/papers-batch-download.ts";
  </script>
</BaseLayout>
