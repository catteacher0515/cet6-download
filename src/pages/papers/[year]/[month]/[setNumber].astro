---
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import mobilePreviewManifest from "../../../../../public/previews/mobile-preview-manifest.json";
import { buildPaperPreviewPagePath, papers } from "../../../../data/cet6";
import { withBase } from "../../../../utils/paths";

export function getStaticPaths() {
  return papers.map((paper) => ({
    params: {
      year: String(paper.year),
      month: String(paper.month),
      setNumber: String(paper.setNumber)
    },
    props: {
      paper
    }
  }));
}

const { paper } = Astro.props;
const currentBase = import.meta.env.BASE_URL;
const mobilePageCount = mobilePreviewManifest[paper.id] ?? 0;
const mobilePreviewPages = Array.from({ length: mobilePageCount }, (_, index) =>
  withBase(buildPaperPreviewPagePath(paper.year, paper.month, paper.setNumber, index + 1), currentBase)
);
---

<BaseLayout
  title={`${paper.title} - 在线预览`}
  description={`${paper.title} 在线预览与 PDF 下载。`}
  pathname="/papers"
  shellClassName="site-shell--reader"
  mainClassName="reader-main"
  hideHeader
  hideFooter
>
  <section class="reader-page">
    <div class="reader-stage">
      <div class="reader-stage__toolbar">
        <div class="reader-stage__toolbar-start">
          <a class="reader-toolbar-button reader-toolbar-button--ghost" href={withBase("/papers", currentBase)}>
            返回真题列表
          </a>
        </div>
        <div class="reader-stage__labels">
          <span>PDF 阅读器</span>
          <span>{paper.title}</span>
        </div>
        <div class="reader-stage__toolbar-end">
          <a class="reader-toolbar-button reader-toolbar-button--primary" href={withBase(paper.pdfPath, currentBase)} download>
            下载 PDF
          </a>
        </div>
      </div>

      <div
        class="reader-pdfjs"
        data-reader-pdfjs
        data-pdf-url={withBase(paper.pdfPath, currentBase)}
        data-pdf-title={paper.title}
      >
        <div class="reader-pdfjs__meta">
          <p class="reader-pdfjs__status" data-reader-status>
            正在初始化预览器...
          </p>
        </div>
        <div class="reader-pdfjs__pages" data-reader-pages></div>
      </div>

      <div class="reader-mobile-preview" data-mobile-preview-root>
        <div class="reader-pdfjs__meta">
          <p class="reader-pdfjs__status">移动端预览</p>
        </div>
        <div class="reader-mobile-preview__pages">
          {mobilePreviewPages.map((pageSrc, index) => (
            <figure class="reader-mobile-preview__page">
              <img
                src={pageSrc}
                alt={`${paper.title} 第${index + 1}页`}
                loading={index < 2 ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={index === 0 ? "high" : "auto"}
              />
            </figure>
          ))}
        </div>
      </div>
    </div>
  </section>

  {
    paper.audioPath ? (
      <aside class="reader-audio-bar" aria-label="听力音频">
        <button class="reader-audio-bar__toggle" type="button" data-audio-toggle aria-label="播放或暂停">
          ▶
        </button>
        <div class="reader-audio-bar__time">
          <span class="reader-audio-bar__time-current" data-audio-current>00:00</span>
          <span>/</span>
          <span class="reader-audio-bar__time-total" data-audio-total>00:00</span>
        </div>
        <input
          class="reader-audio-bar__seek"
          type="range"
          min="0"
          max="0"
          value="0"
          step="0.1"
          data-audio-seek
          aria-label="音频播放进度"
        />
        <audio
          class="reader-audio-bar__media"
          controlsList="nodownload noplaybackrate"
          playsinline
          preload="metadata"
          data-audio-media
          src={withBase(paper.audioPath, currentBase)}
        >
          你的浏览器暂不支持音频播放，请直接下载后使用。
        </audio>
      </aside>
    ) : null
  }

  <script>
    import "../../../../scripts/pdf-reader.ts";
  </script>
</BaseLayout>
